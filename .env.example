# =========================================================
# El servidor lee backend/.env  (ver backend/src/interfaces/server.js)
#   cp .env.example backend/.env
# =========================================================

# ---------- Servidor ----------
PORT=3000
JWT_SECRET=cambia_esto
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Correo (EmailServicePort -> NodemailerAdapter) ----------
# ethereal | mailtrap | smtp | none
EMAIL_PROVIDER=ethereal

# Ethereal: puedes dejar SMTP_USER/SMTP_PASS vacíos y se crea
# una cuenta de prueba al arrancar (se imprime en consola).
# Mailtrap: copia usuario y contraseña de tu Sandbox
#   (Email Testing > Inboxes > SMTP Settings).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

EMAIL_FROM="Tienda 5M" <no-reply@tienda5m.test>
ADMIN_EMAIL=admin@tienda5m.test
STORE_NAME=Tienda 5M
ADMIN_PANEL_URL=http://localhost:5173

# ---------- Instrucciones de pago (datos de ejemplo) ----------
PAY_BANK=BBVA México
PAY_HOLDER=Tienda 5M S.A. de C.V.
PAY_ACCOUNT=0123456789
PAY_CLABE=012100001234567895
PAY_PROOF_EMAIL=pagos@tienda5m.test
PAY_DEADLINE_HOURS=48

# Solo para npm run email:prueba
TEST_CLIENT_EMAIL=cliente@tienda5m.test

# ---------- n8n (automatización) ----------
# Con EMAIL_PROVIDER=n8n el backend publica cada pedido en este webhook
# y n8n envía las notificaciones. Si n8n no responde, se usa
# N8N_RESPALDO (ethereal | mailtrap | smtp | none).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pedido-creado
N8N_WEBHOOK_SECRET=cambia-este-secreto
N8N_TIMEOUT_MS=5000
N8N_RESPALDO=ethereal

# Clave para que n8n consulte /api/reportes (header X-API-Key).
# Mínimo 24 caracteres. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REPORTES_API_KEY=
